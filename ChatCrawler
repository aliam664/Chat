      pairs.forEach(function (p, i) { if (p[1] > pairs[peak][1]) peak = i; });
      pairs.forEach(function (p, i) {
        var x = 4 + i * band + (band - bw) / 2, hgt = p[1] ? Math.max(2, Math.round((H - top) * p[1] / mx)) : 0, y = H - hgt;
        var r = Math.min(4, bw / 2, hgt);
