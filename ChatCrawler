    function wireViz(root) {
      Array.prototype.forEach.call(root.querySelectorAll('.viz'), function (v) {
        var tip = v.querySelector('.viz-tip');
        v.addEventListener('mousemove', function (e) {
          var t = e.target.closest('[data-tip]');
          if (!t) { tip.style.display = 'none'; return; }
          var vr = v.getBoundingClientRect(), tr = t.getBoundingClientRect();
          tip.textContent = t.getAttribute('data-tip');
          tip.style.display = 'block';
          tip.style.left = (tr.left - vr.left + tr.width / 2) + 'px';
          tip.style.top = Math.max(14, e.clientY - vr.top - 4) + 'px';
        });
        v.addEventListener('mouseleave', function () { tip.style.display = 'none'; });
      });
    }

    /* ── клавиши ───────────────────────────────────────────────────── */
    doc.addEventListener('keydown', function (e) {
      var tg = e.target, typing = tg && (tg.tagName === 'INPUT' || tg.tagName === 'SELECT' || tg.tagName === 'TEXTAREA');
      if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F') && S.view === 'chats' && doc.getElementById('chat')) { e.preventDefault(); openChatSearch(); return; }
      if (!typing && e.key === '/') {
        var inp = S.view === 'dir' ? doc.getElementById('dq') : doc.getElementById('lq');
        if (inp) { e.preventDefault(); inp.focus(); }
      }
      if (e.key === 'Escape' && S.info && !typing) setInfo(false);
    });

    var first = VIEWS[0];
    if (KIND === 'author' || KIND === 'venue') first = MS.length ? 'chats' : (VIEWS.indexOf('dir') >= 0 && !MS.length && KIND === 'venue' ? 'dir' : 'prof');
    if (window.matchMedia && matchMedia('(min-width: 1320px)').matches && first === 'chats') S.info = true;
    go(first);
    if (S.info) setInfo(true, true);
  }

